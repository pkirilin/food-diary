# See docs/guide/deployment.md#configuration-reference for what each variable does.

# ---- Required ----

# Domain the app is served on, without https://. Its DNS record must point at this server.
DOMAIN=food.example.com

# Password for the bundled PostgreSQL database. Generate one, e.g. with: openssl rand -hex 32
POSTGRES_PASSWORD=

# Google account allowed to sign in. Add more as Auth__AllowedEmails__1, __2, ...
Auth__AllowedEmails__0=you@gmail.com

GoogleAuth__ClientId=
GoogleAuth__ClientSecret=

# ---- Optional: AI food recognition from photos ----
# Integrations__OpenAI__ApiKey=
# Integrations__OpenAI__BaseUrl=https://api.openai.com/v1
# Integrations__OpenAI__Model=gpt-5.4-mini

# ---- Optional: MCP server ----
# Mcp__Enabled=true
# Mcp__Clients__0__ClientId=
# Mcp__Clients__0__ClientSecret=
# Mcp__Clients__0__RedirectUri=https://claude.ai/api/mcp/auth_callback
