{
  "name": "food-diary",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "test": "vitest",
    "test:preview": "vitest-preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "update-sdks": "yarn dlx @yarnpkg/sdks",
    "refresh-lockfiles": "yarn dedupe && yarn up -R node-gyp"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.9.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/system": "^9.4.0",
    "@mui/utils": "^9.4.0",
    "@mui/x-charts": "^9.14.0",
    "@mui/x-date-pickers": "^9.14.0",
    "@reduxjs/toolkit": "^2.12.0",
    "date-fns": "^3.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-ga4": "^3.0.1",
    "react-hook-form": "^7.88.0",
    "react-redux": "^9.3.0",
    "react-router": "^7.18.4",
    "react-zoom-pan-pinch": "^4.2.0",
    "use-debounce": "^10.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.19.1",
    "@eslint/js": "^10.0.1",
    "@mswjs/data": "^0.16.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "browserslist": "^4.29.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-testing-library": "^7.16.2",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.7",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "vitest-preview": "^0.0.3",
    "workbox-precaching": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "browserslist": {
    "production": [
      "chrome >= 117",
      "edge >= 121",
      "firefox >= 121",
      "safari >= 17.0",
      "ios_saf >= 17.0"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "packageManager": "yarn@4.16.0",
  "msw": {
    "workerDirectory": "public"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "resolutions": {
    "@mswjs/data/uuid": "^11.1.1"
  }
}
